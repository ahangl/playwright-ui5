{
  "name": "@ahangl/playwright-ui5",
  "version": "0.0.1",
  "description": "E2E tests for UI5 apps (Playwright + UI5 Testing API)",
  "keywords": [
    "playwright",
    "ui5",
    "sapui5",
    "openui5"
  ],
  "homepage": "https://ahangl.github.io/playwright-ui5/",
  "bugs": {
    "url": "https://github.com/ahangl/playwright-ui5/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahangl/playwright-ui5.git"
  },
  "license": "MIT",
  "author": "ahangl <44925346+ahangl@users.noreply.github.com>",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && node scripts/mark-optional-types.mjs",
    "typecheck": "npm run build --silent && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json && tsc --noEmit -p test/types/without-sapui5 && tsc --noEmit -p test/types/with-sapui5",
    "start:app": "cd test/fixture-app && ui5 serve --port 8080",
    "test": "npm run build && playwright test --project=local",
    "test:workzone": "npm run build && playwright test --project=workzone",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepublishOnly": "npm run lint && npm run format && npm run typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "node scripts/deploy-docs.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.60.0",
    "@sapui5/types": ">=1.120.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sap-ux/ui5-middleware-fe-mockserver": "2.4.19",
    "@sapui5/types": "1.154.0",
    "@types/node": "22.20.5",
    "@ui5/cli": "4.0.73",
    "dotenv": "18.0.10",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitepress": "1.6.4",
    "vitepress-plugin-llms": "1.15.0"
  },
  "peerDependenciesMeta": {
    "@sapui5/types": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
