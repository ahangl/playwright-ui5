{
  // A consumer that installs the optional peer dependency @sapui5/types and checks the declaration files
  // of its dependencies (skipLibCheck: false). The Fiori elements chains are typed from SAP's typings.
  // jquery, qunit, three and offscreencanvas are dependencies of @sapui5/types that its typings need.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@sapui5/types", "jquery", "qunit", "three", "offscreencanvas"],
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true
  },
  "files": ["../fe-on-table.ts"]
}
