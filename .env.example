# Copy to .env (git-ignored) for the opt-in SAP Build Work Zone tests: npm run test:workzone
WORKZONE_URL=https://<subdomain>.launchpad.cfapps.eu10.hana.ondemand.com/site/<site-id>
UI5_USERNAME=
UI5_PASSWORD=
# Optional: IdP to pick on the XSUAA IdP selection page, e.g. <tenant>.accounts.ondemand.com
WORKZONE_IDP=
# Optional: SAP Fiori elements V4 List Report app to check
WORKZONE_APP_INTENT=#Books-manage
WORKZONE_APP_ID=
WORKZONE_LR_COMPONENT=
WORKZONE_CONTEXT_PATH=
